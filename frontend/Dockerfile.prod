# Production build: compile once, serve the static output with nginx —
# not the dev-mode image in Dockerfile (Vite dev server + bind mount, no
# minification). Not wired into docker-compose.yml on purpose: the primary
# documented workflow (README Quickstart) is the dev image's hot-reload
# loop, and this shouldn't change that default. Build/run standalone:
#   docker build -f Dockerfile.prod -t inveniops-frontend-prod .
#   docker run -p 8080:80 inveniops-frontend-prod
#
# VITE_API_BASE_URL and VITE_SITE_URL are compiled into the static bundle
# at build time (Vite env vars aren't a runtime concept for a static
# build) — override them with --build-arg for a real deployment.
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_API_BASE_URL=http://localhost:3000
ARG VITE_SITE_URL=http://localhost:5173
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_SITE_URL=${VITE_SITE_URL}
RUN npm run build

FROM nginx:1.27-alpine AS production
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
